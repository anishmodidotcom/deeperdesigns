{
  "name": "sidonstage",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone static export for sid.onstage / deeperdesigns.in/sidonstage. Isolated from the DD app.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "export:public": "next build --turbopack && rm -rf ../public/sidonstage && mkdir -p ../public/sidonstage && cp -R out/. ../public/sidonstage/ && echo 'Exported to ../public/sidonstage/'",
    "gen:atmos": "bun run scripts/generate-images.ts",
    "gen:video": "bun run scripts/generate-videos.ts",
    "extract:pdf": "bun run scripts/extract-pdf-assets.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "motion": "^12.23.12",
    "next": "16.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-fast-marquee": "^1.6.5"
  },
  "devDependencies": {
    "@google/genai": "^1.30.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.0"
  }
}
