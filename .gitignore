# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Lockfiles from other package managers. The project is bun-only;
# bun.lock is the single source of truth. Vercel install pinned to bun
# via vercel.json so foreign lockfiles cannot trigger frozen-lockfile
# installs.
pnpm-lock.yaml
package-lock.json
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Documentation file: real values never committed, but the example
# template (env var names with empty values) is checked in.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal AI co-worker scaffolding — never commit, future sessions carry their own context.
AGENTS.md
CLAUDE.md
*.agent.md

# Internal cost + manifest artifacts — workshop-only, never public.
scripts/cost-log.json
scripts/cost-log.*.json

# v25.5: neither of these is deployed (.vercelignore excludes both) and
# together they are ~130 MB of tracked binaries that only grow. The
# existing history is left alone deliberately, no rewrite; these entries
# stop further growth. Anything already committed stays tracked until it
# is removed in a dedicated pass.
/marketing/
/build-artifacts/
