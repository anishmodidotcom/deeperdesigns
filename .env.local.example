# Meta Pixel + CAPI (v17)
# Values are documented here as patterns only — never commit real
# credentials. Anish sets the real values in the Vercel dashboard
# (Project → Settings → Environment Variables) before merge.

# Browser-side Pixel ID. Public; embedded in document HTML.
NEXT_PUBLIC_META_PIXEL_ID=

# Server-side Conversions API token. Server-only, never expose.
META_CAPI_ACCESS_TOKEN=


# Test Event Code from Events Manager. Only attached in non-production.
META_TEST_EVENT_CODE=

# Optional: set to "true" to console.log every event firing (event_id +
# props). Off in production by default. Public flag, browser-readable.
NEXT_PUBLIC_META_PIXEL_DEBUG=

# ---- Email delivery (Resend). Required in production. ----
# Without RESEND_API_KEY the lead routes return 500 and log
# email_not_configured rather than silently accepting a lead (v25).
# Server-only.
RESEND_API_KEY=
# From address for the code email and the completion email. Optional;
# defaults to "Deeper Designs <no-reply@deeperdesigns.in>".
RESEND_FROM=
# Where completed lead and community notifications are sent. Optional;
# defaults to anish.modi@deeperdesigns.in.
NOTIFY_EMAIL=

# ---- Vercel KV (Upstash Redis). Optional but strongly recommended. ----
# Backs the OTP store and the rate limiter. When unset, both fall back to
# a per-instance in-memory map, which does not survive cold starts and is
# not shared across serverless instances, so codes can go missing and the
# rate limits are effectively per-instance. Set BOTH or neither: the code
# enables the KV path on KV_REST_API_URL alone, and a URL without a token
# fails every call (v25 makes that degrade to in-memory rather than 500,
# but it is still a broken configuration).
KV_REST_API_URL=
KV_REST_API_TOKEN=


# ==========================================================================
# v29 · Preflight (deeperdesigns.in/preflight)
# ==========================================================================
# The build compiles and the page renders with none of these set. Without
# the Razorpay keys the "Pay with Razorpay" button is disabled and a
# dev-only notice explains why; nothing on the page 500s.

# ---- Razorpay Standard Checkout ----
# Test keys first. The live key goes in only after the v29 acceptance
# tests pass, and that swap is an environment change, not a code change.
# Server-only. Never expose.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the webhook in the Razorpay dashboard. Used to
# verify X-Razorpay-Signature over the RAW request body. Server-only.
RAZORPAY_WEBHOOK_SECRET=
# The same key id as RAZORPAY_KEY_ID, exposed to the browser so Standard
# Checkout can open. Public by design; the secret never is.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Commercials ----
# Rupees, GST inclusive. Drives the price on the page, the Razorpay order
# amount (x100 paise), the receipt, and the amount check on fulfilment.
PREFLIGHT_PRICE_INR=10000
# Percent, already included in PREFLIGHT_PRICE_INR. Base and GST on the
# confirmation receipt and in the notification email are derived from it.
PREFLIGHT_GST_RATE=18
# SAC code shown on the receipt and in the notification email.
PREFLIGHT_SAC=998314

# ---- Notifications ----
# Where the sale notification lands. Sent through the existing Resend
# setup, so RESEND_API_KEY above is also required for this to send.
PREFLIGHT_NOTIFY_EMAIL=hey@deeperdesigns.in
# The support address shown on the page, the receipt and the terms.
PREFLIGHT_SUPPORT_EMAIL=hello@deeperdesigns.in

# ---- Fulfilment queue (Google Sheets) ----
# The spreadsheet id from its URL. One row is appended per paid order to
# the first sheet, in a fixed column order (see lib/preflight-sheets.ts).
GOOGLE_SHEETS_ID=
# base64 of the service account key JSON. Base64 because a raw key file
# has newlines inside the private key that do not survive a dashboard
# text field. The service account needs edit access on the sheet.
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Note: KV_REST_API_URL / KV_REST_API_TOKEN above are also the store for
# the fulfilment idempotency key (preflight:paid:<payment_id>). Without
# KV, fulfilment falls back to scanning the sheet for the payment id
# before writing, and logs loudly.
