# Meta Pixel + CAPI (v17)
# Values are documented here as patterns only — never commit real
# credentials. Anish sets the real values in the Vercel dashboard
# (Project → Settings → Environment Variables) before merge.

# Browser-side Pixel ID. Public; embedded in document HTML.
NEXT_PUBLIC_META_PIXEL_ID=

# Server-side Conversions API token. Server-only, never expose.
META_CAPI_ACCESS_TOKEN=


# Test Event Code from Events Manager. Only attached in non-production.
META_TEST_EVENT_CODE=

# Optional: set to "true" to console.log every event firing (event_id +
# props). Off in production by default. Public flag, browser-readable.
NEXT_PUBLIC_META_PIXEL_DEBUG=

# ---- Email delivery (Resend). Required in production. ----
# Without RESEND_API_KEY the lead routes return 500 and log
# email_not_configured rather than silently accepting a lead (v25).
# Server-only.
RESEND_API_KEY=
# From address for the code email and the completion email. Optional;
# defaults to "Deeper Designs <no-reply@deeperdesigns.in>".
RESEND_FROM=
# Where completed lead and community notifications are sent. Optional;
# defaults to anish.modi@deeperdesigns.in.
NOTIFY_EMAIL=

# ---- Vercel KV (Upstash Redis). Optional but strongly recommended. ----
# Backs the OTP store and the rate limiter. When unset, both fall back to
# a per-instance in-memory map, which does not survive cold starts and is
# not shared across serverless instances, so codes can go missing and the
# rate limits are effectively per-instance. Set BOTH or neither: the code
# enables the KV path on KV_REST_API_URL alone, and a URL without a token
# fails every call (v25 makes that degrade to in-memory rather than 500,
# but it is still a broken configuration).
KV_REST_API_URL=
KV_REST_API_TOKEN=
